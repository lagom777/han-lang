# === 가나다 실전 파이프라인: 데이터 파일 분석 리포트 ===
# 파일 입출력 + JSON + 데이터 toolkit을 한 스크립트로 (생성→읽기→분석→쓰기→확인)

# 1) 샘플 데이터를 JSON 파일로 저장 (보통은 외부에서 받은 파일)
판매 = [
    {"상품": "노트북", "분류": "전자", "금액": 1200000},
    {"상품": "마우스", "분류": "전자", "금액": 25000},
    {"상품": "책상", "분류": "가구", "금액": 150000},
    {"상품": "의자", "분류": "가구", "금액": 90000},
    {"상품": "키보드", "분류": "전자", "금액": 70000}
]
파일쓰기("/tmp/han_판매.json", 제이슨문자열(판매))

# 2) 파일에서 다시 읽어 분석
원본 = 제이슨파싱(파일읽기("/tmp/han_판매.json"))
총매출 = 접기(원본, 0, 람다(합, p) { 반환 합 + p["금액"] })
분류별 = 빈도(변환(원본, 람다(p) { 반환 p["분류"] }))
최고 = 최대기준(원본, 람다(p) { 반환 p["금액"] })

# 3) 리포트 작성 후 파일로 저장
리포트 = 합치기([
    "= 판매 리포트 =",
    "총매출: " + 천단위(총매출) + "원",
    "분류별 건수: " + 제이슨문자열(분류별),
    "베스트셀러: " + 최고["상품"]
], "\n")
파일쓰기("/tmp/han_리포트.txt", 리포트)

# 4) 저장된 리포트를 다시 읽어 출력
출력(파일읽기("/tmp/han_리포트.txt"))
