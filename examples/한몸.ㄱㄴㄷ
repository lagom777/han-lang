# 한 몸 풀스택 — 방명록 한 파일: 프론트(HTML)·백엔드(서버)·디비(SQLite)를 가나다 하나로.
# SQL 0줄, HTML 0줄 — 저장소·넣기·모두 + 문서·글·목록·연결·입력폼 조합이 전부다.
#   ./가나다 실행 examples/한몸.ㄱㄴㄷ
#   브라우저: http://localhost:8000  (글 등록 → 목록에 바로 반영)

방명록 = 저장소("방명록.db", "글들")

함수 첫화면(요청) {
    글들 = 모두(방명록)
    줄들 = []
    반복 항목 를 글들 에서 {
        추가(줄들, 항목["번호"] + ". " + 항목["이름"] + ": " + 항목["내용"])
    }
    반환 문서("방명록",
        글("방명록", 1),
        글("지금까지 " + 길이(글들) + "개의 글이 있어요."),
        목록(줄들),
        글("새 글 남기기", 2),
        입력폼("/등록", ["이름", "내용"], "남기기"))
}

함수 등록(요청) {
    이름 = 값얻기(요청["질의"], "이름", "익명")
    내용 = 값얻기(요청["질의"], "내용", "")
    번호 = 넣기(방명록, {"이름": 이름, "내용": 내용})
    반환 문서("등록 완료",
        글("등록 완료!", 1),
        글(이름 + " 님의 글이 " + 번호 + "번으로 저장됐어요."),
        연결("/", "방명록으로 돌아가기"))
}

서버(8000, {"/": 첫화면, "/등록": 등록})
