# 탐색 도우미 — 찾기(find) · 있나(any) · 모두(all)
재고 = [
    {"이름": "사과", "수량": 0},
    {"이름": "바나나", "수량": 5},
    {"이름": "포도", "수량": 12}
]

# 품절 상품 찾기 (첫 매치)
품절 = 찾기(재고, 람다(품목) { 반환 품목["수량"] == 0 })
만약 품절 != 없음 {
    출력(품절["이름"] + " 품절!")
}

# 조건 검사
출력("품절 있나? " + 있나(재고, 람다(p) { 반환 p["수량"] == 0 }))
출력("전부 재고 있나? " + 모두(재고, 람다(p) { 반환 p["수량"] > 0 }))
