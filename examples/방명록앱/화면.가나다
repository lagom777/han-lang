# 화면 — HTML 조합 함수들 (화면 관심사만: 무엇을 어떻게 보여줄지. HTML 0줄)
# 앱.가나다 가 모듈("화면.가나다") 로 불러 쓴다. 자료를 모르고, 받은 값만 그린다.
함수 방명록화면(글들) {
    줄들 = []
    반복 항목 를 글들 에서 {
        추가(줄들, 항목["번호"] + ". " + 항목["이름"] + ": " + 항목["내용"])
    }
    반환 문서("방명록",
        글("방명록", 1),
        글("지금까지 " + 길이(글들) + "개의 글이 있어요."),
        목록(줄들),
        글("새 글 남기기", 2),
        입력폼("/등록", ["이름", "내용"], "남기기"))
}

함수 등록화면(이름, 번호) {
    반환 문서("등록 완료",
        글("등록 완료!", 1),
        글(이름 + " 님의 글이 " + 번호 + "번으로 저장됐어요."),
        연결("/", "방명록으로 돌아가기"))
}
