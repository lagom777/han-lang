# 최대기준/최소기준 — 키 함수로 최고/최저 원소 찾기 (argmax/argmin)
제품 = [
    {"이름": "노트북", "가격": 1200},
    {"이름": "마우스", "가격": 25},
    {"이름": "키보드", "가격": 70}
]
비쌈 = 최대기준(제품, 람다(p) { 반환 p["가격"] })
쌈 = 최소기준(제품, 람다(p) { 반환 p["가격"] })
출력("제일 비싼 것: " + 비쌈["이름"] + " (" + 비쌈["가격"] + ")")
출력("제일 싼 것: " + 쌈["이름"] + " (" + 쌈["가격"] + ")")
