# 접기(reduce) — 목록을 하나의 값으로 누적
수들 = [10, 15, 20, 25, 30]

합계 = 접기(수들, 0, 람다(누적, x) { 반환 누적 + x })
출력("합계: " + 합계)

최댓값 = 접기(수들, 수들[0], 람다(a, b) {
    만약 a > b { 반환 a }
    반환 b
})
출력("최댓값: " + 최댓값)

# 변환·거르기·접기 파이프라인: 짝수만 골라 합
짝수합 = 접기(거르기(수들, 람다(n) { 반환 n % 2 == 0 }), 0, 람다(a, b) { 반환 a + b })
출력("짝수합: " + 짝수합)
