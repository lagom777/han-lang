# SQLite 방명록 — 자료열기/실행/질의/자료닫기 로 데이터베이스 다루기.
#   ./가나다 실행 examples/자료.ㄱㄴㄷ
# 경로에 파일명(예: "방명록.db")을 주면 디스크에 저장되어 껐다 켜도 유지된다.
# 여기선 데모라 ":memory:"(메모리 전용) 사용. 값 끼워넣기는 문자열 잇기 대신
# ? 자리표시자 + 인자목록 을 쓴다(SQL 주입 방지).

자료 = 자료열기(":memory:")
실행(자료, "CREATE TABLE 방명록(id INTEGER PRIMARY KEY, 이름 TEXT, 말 TEXT)")

실행(자료, "INSERT INTO 방명록(이름, 말) VALUES (?, ?)", ["철수", "가나다로 SQL 을 쓰다니!"])
실행(자료, "INSERT INTO 방명록(이름, 말) VALUES (?, ?)", ["영희", "방명록 남깁니다"])
실행(자료, "INSERT INTO 방명록(이름, 말) VALUES (?, ?)", ["민수", "한글 컬럼명도 되네요"])

글들 = 질의(자료, "SELECT * FROM 방명록 ORDER BY id")
출력("방명록 " + 길이(글들) + "건")
반복 글 를 글들 에서 {
    출력(글["id"] + ". " + 글["이름"] + ": " + 글["말"])
}

# ? 바인딩으로 조건 검색
찾은 = 질의(자료, "SELECT 말 FROM 방명록 WHERE 이름 = ?", ["영희"])
출력("영희의 말: " + 찾은[0]["말"])

자료닫기(자료)
