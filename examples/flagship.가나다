# === 가나다 종합 예제: 판매 데이터 분석 ===
# 목록·사전·함수·람다·변환·거르기·접기·정렬기준·고유·foreach 인덱스·구조 분해·채우기·JSON 총동원

판매 = [
    {"상품": "노트북", "분류": "전자", "금액": 1200000, "수량": 3},
    {"상품": "마우스", "분류": "전자", "금액": 25000, "수량": 50},
    {"상품": "책상", "분류": "가구", "금액": 150000, "수량": 8},
    {"상품": "의자", "분류": "가구", "금액": 90000, "수량": 12},
    {"상품": "키보드", "분류": "전자", "금액": 70000, "수량": 20}
]

# 항목 매출 = 금액 × 수량
함수 매출(항목) { 반환 항목["금액"] * 항목["수량"] }

# 1) 총매출 (접기)
총매출 = 접기(판매, 0, 람다(합, 항목) { 반환 합 + 매출(항목) })
출력("총매출: " + 총매출 + "원")

# 2) 전자 분류만(거르기) → 매출 높은 순(정렬기준 + 거꾸로)
순위표 = 거꾸로(정렬기준(거르기(판매, 람다(p) { 반환 p["분류"] == "전자" }), 매출))
출력("")
출력("[전자] 매출 순위")
반복 i, 항목 를 순위표 에서 {
    줄 = 오른쪽채우기(왼쪽채우기(i + 1, 2) + ". " + 항목["상품"], 14) + 왼쪽채우기(매출(항목), 12) + "원"
    출력(줄)
}

# 3) 베스트셀러(1위) + 분류 목록(고유·변환)
최고 = 순위표[0]
출력("")
출력("베스트셀러: " + 최고["상품"])

# 4) JSON 요약
요약 = {"총매출": 총매출, "분류": 고유(변환(판매, 람다(p) { 반환 p["분류"] })), "베스트셀러": 최고["상품"]}
출력("")
출력("JSON 요약:")
출력(제이슨문자열(요약, 2))
