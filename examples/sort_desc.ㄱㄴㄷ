# 정렬 내림차순 — 리더보드/랭킹에 유용. 2번째(정렬) / 3번째(정렬기준) 인자 참이면 내림차순.
점수들 = [72, 95, 88, 61, 100]
출력("높은 순: " + 정렬(점수들, 참))
출력("낮은 순: " + 정렬(점수들))

선수들 = [{"이름": "가", "점수": 72}, {"이름": "나", "점수": 100}, {"이름": "다", "점수": 88}]
순위 = 정렬기준(선수들, 람다(p) { 반환 p["점수"] }, 참)
출력("1위: " + 순위[0]["이름"] + " (" + 순위[0]["점수"] + "점)")
