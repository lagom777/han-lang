# 메모장 — 줄 단위 텍스트 편집기 (가나다 OS 미니 앱)
# 실행: ./가나다 실행 examples/메모장.ㄱㄴㄷ  (가나다셸에서 '메모장' 으로도 실행)

함수 메모장열기(경로) {
    줄들 = []
    만약 파일존재(경로) { 줄들 = 줄나누기(파일읽기(경로))
        출력("📂 " + 경로 + " — " + 길이(줄들) + "줄 불러옴") }
    아니면 { 출력("🆕 새 파일: " + 경로) }
    변경됨 = 거짓
    출력("명령: 보기 · 줄추가 <텍스트> · 줄지우기 <번호> · 저장 · 끝")
    동안 참 {
        줄 = 입력("메모📝> ")
        만약 타입(줄) == "없음" { 출력("")
            멈춤 }                            # EOF → 종료
        조각 = 나누기(다듬기(줄))
        만약 길이(조각) == 0 { 계속 }
        명령 = 조각[0]
        만약 명령 == "보기" {
            만약 길이(줄들) == 0 { 출력("(빈 파일)") }
            반복 i, 내용 를 줄들 에서 { 출력(왼쪽채우기(i + 1, 3) + " | " + 내용) }
        }
        아니면 만약 명령 == "줄추가" {
            추가(줄들, 합치기(조각[1:], " "))
            변경됨 = 참
            출력("+ " + 길이(줄들) + "번 줄")
        }
        아니면 만약 명령 == "줄지우기" {
            만약 길이(조각) != 2 또는 아니다 숫자인가(조각[1]) { 출력("사용법: 줄지우기 <번호>")
                계속 }
            번호 = 숫자(조각[1])
            만약 번호 < 1 또는 번호 > 길이(줄들) { 출력("1~" + 길이(줄들) + " 사이 번호를 주세요")
                계속 }
            줄들 = 줄들[:번호 - 1] + 줄들[번호:]
            변경됨 = 참
            출력("- " + 번호 + "번 줄 지움")
        }
        아니면 만약 명령 == "저장" {
            글자수 = 파일쓰기(경로, 합치기(줄들, "\n"))
            변경됨 = 거짓
            출력("💾 저장: " + 길이(줄들) + "줄, " + 글자수 + "글자")
        }
        아니면 만약 명령 == "끝" {
            만약 변경됨 {
                답 = 입력("저장 안 한 변경이 있어요. 그래도 나갈까요? (예/아니오) ")
                만약 타입(답) == "없음" 또는 다듬기(답) == "예" { 멈춤 }
                출력("계속 편집해요 ('저장' 후 '끝')")
            }
            아니면 { 멈춤 }
        }
        아니면 { 출력("모르는 명령: " + 명령 + " (보기·줄추가·줄지우기·저장·끝)") }
    }
    출력("메모장을 닫아요 👋")
}

경로 = 다듬기(환경변수("메모장파일", ""))   # 가나다셸의 '메모장 <파일>' 이 채워 줌
만약 길이(경로) == 0 {
    입력값 = 입력("📝 파일 경로: ")
    만약 타입(입력값) != "없음" { 경로 = 다듬기(입력값) }
}
만약 길이(경로) == 0 { 출력("경로가 없어 메모장을 닫아요") }
아니면 { 메모장열기(경로) }
