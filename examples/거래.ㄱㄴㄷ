# 거래(핸들, 함수) — 여러 DB 작업을 하나로 묶는다. 함수 안에서 오류가 나면 전부 되돌린다(롤백).
#   ./가나다 실행 examples/거래.ㄱㄴㄷ
# 계좌 이체처럼 "둘 다 성공 아니면 둘 다 취소" 가 필요할 때 쓴다.

자료 = 자료열기(":memory:")
실행(자료, "CREATE TABLE 계좌(이름 TEXT, 잔액 INTEGER)")
실행(자료, "INSERT INTO 계좌 VALUES (?, ?)", ["철수", 1000])
실행(자료, "INSERT INTO 계좌 VALUES (?, ?)", ["영희", 0])

# 성공하는 이체 — 거래 안의 두 갱신이 함께 반영된다
거래(자료, 람다() {
    실행(자료, "UPDATE 계좌 SET 잔액 = 잔액 - 300 WHERE 이름 = ?", ["철수"])
    실행(자료, "UPDATE 계좌 SET 잔액 = 잔액 + 300 WHERE 이름 = ?", ["영희"])
})
출력("이체 후 영희 잔액: " + 질의(자료, "SELECT 잔액 FROM 계좌 WHERE 이름 = ?", ["영희"])[0]["잔액"])

# 실패하는 이체 — 도중에 오류가 나면 앞선 갱신까지 전부 롤백된다
시도 {
    거래(자료, 람다() {
        실행(자료, "UPDATE 계좌 SET 잔액 = 잔액 - 500 WHERE 이름 = ?", ["철수"])
        발생("잔액 부족!")
    })
} 잡기(오류) {
    출력("이체 취소됨: " + 오류)
}
출력("롤백 후 철수 잔액: " + 질의(자료, "SELECT 잔액 FROM 계좌 WHERE 이름 = ?", ["철수"])[0]["잔액"])

자료닫기(자료)
