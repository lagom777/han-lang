# 가나다셸 — 가나다로 짠 대화형 한글 셸 (가나다 OS 1단계)
# 실행: python3 가나다.py 실행 examples/가나다셸.ㄱㄴㄷ  ('도움말' 입력으로 시작)

뿌리 = 현재위치()                 # 셸을 시작한 곳 — 미니 앱(메모장·계산기) 실행에 사용

함수 빨강글(글) { 반환 색칠(글, "빨강") }

함수 위치표시() {
    # 현재위치가 홈 폴더로 시작하면 "~" 로 축약 (프롬프트용)
    곳 = 현재위치()
    집 = 환경변수("HOME", "")
    만약 길이(집) > 0 그리고 시작(곳, 집) { 반환 "~" + 곳[길이(집):] }
    반환 곳
}

함수 도움말표() {
    출력(색칠("가나다셸 명령", "굵게"))
    출력("  도움말 (도움, ?)           이 표 보기")
    출력("  목록 [경로] (ls)           파일·폴더 나열 (폴더 먼저)")
    출력("  이동 <경로> (cd)           위치 바꾸기 — 인자 없으면 홈으로")
    출력("  어디 (pwd)                 현재 위치 출력")
    출력("  보기 <파일> (cat)          파일 내용을 줄번호와 함께")
    출력("  만들기 <이름> (touch)      빈 파일 생성 — 이름이 /로 끝나면 폴더 생성")
    출력("  지우기 <경로> (rm)         확인(예/아니오) 후 파일·빈 폴더 삭제")
    출력("  복사 <원본> <대상> (cp)    파일 복사")
    출력("  이름바꾸기 <옛> <새> (mv, 옮기기)  이름 바꾸기·이동")
    출력("  찾기 <이름조각> (find)     하위 폴더까지 이름 검색")
    출력("  실행 <명령...> (!)         외부 명령 실행")
    출력("  시계 (시간)                현재 날짜·시간")
    출력("  메모장 [파일] / 계산기     미니 앱 실행")
    출력("  끝 (종료, exit)            셸 나가기")
}

함수 목록보기(경로) {
    이름들 = []
    시도 { 이름들 = 파일목록(경로) } 잡기(오류) { 출력(빨강글(오류))
        반환 }
    폴더들 = []
    파일들 = []
    반복 이름 를 이름들 에서 {
        시도 {
            정보 = 파일정보(경로 + "/" + 이름)
            만약 정보["종류"] == "폴더" { 추가(폴더들, 이름) }
            아니면 { 추가(파일들, [이름, 정보["크기"]]) }
        } 잡기(오류) { }                       # 깨진 링크 등은 건너뜀
    }
    반복 이름 를 폴더들 에서 {
        출력("📁 폴더 " + 왼쪽채우기("-", 12) + "  " + 이름)
    }
    반복 쌍 를 파일들 에서 {
        출력("📄 파일 " + 왼쪽채우기(천단위(쌍[1]) + "B", 12) + "  " + 쌍[0])
    }
    출력("(폴더 " + 길이(폴더들) + "개 · 파일 " + 길이(파일들) + "개)")
}

함수 보기하기(경로) {
    시도 {
        줄들 = 줄나누기(파일읽기(경로))
        반복 i, 내용 를 줄들 에서 { 출력(왼쪽채우기(i + 1, 4) + " | " + 내용) }
    } 잡기(오류) { 출력(빨강글(오류)) }
}

함수 만들기하기(이름) {
    시도 {
        만약 끝(이름, "/") { 폴더생성(이름)
            출력("📁 폴더 생성: " + 이름) }
        아니면 { 파일쓰기(이름, "")
            출력("📄 빈 파일 생성: " + 이름) }
    } 잡기(오류) { 출력(빨강글(오류)) }
}

함수 지우기하기(경로) {
    만약 아니다 파일존재(경로) { 출력(빨강글("지우기: '" + 경로 + "' 가 없습니다"))
        반환 }
    정보 = 파일정보(경로)
    답 = 입력(정보["종류"] + " '" + 경로 + "' 정말 지울까요? (예/아니오) ")
    만약 타입(답) != "없음" 그리고 다듬기(답) == "예" {
        시도 { 파일삭제(경로)
            출력("🗑️ 지웠어요: " + 경로) } 잡기(오류) { 출력(빨강글(오류)) }
    }
    아니면 { 출력("취소했어요") }
}

# 가나다로 짠 재귀 찾기 — 폴더면 하강, 이름에 조각이 들어 있으면 상대경로 출력
함수 찾아보기(폴더, 조각) {
    찾은수 = 0
    이름들 = []
    시도 { 이름들 = 파일목록(폴더) } 잡기(오류) { 반환 0 }   # 권한 오류 등은 무시
    반복 이름 를 이름들 에서 {
        경로 = 폴더 + "/" + 이름
        만약 포함(이름, 조각) { 출력("  " + 경로)
            찾은수 += 1 }
        시도 {
            만약 파일정보(경로)["종류"] == "폴더" { 찾은수 += 찾아보기(경로, 조각) }
        } 잡기(오류) { }
    }
    반환 찾은수
}

함수 외부실행하기(명령) {
    코드 = 외부실행(명령)
    만약 코드 != 0 { 출력(빨강글("종료코드 " + 코드)) }
}

함수 앱실행(이름, 파일인자) {
    # 셸을 시작한 폴더(뿌리)에 가나다.py 가 있어야 미니 앱을 띄울 수 있다
    만약 아니다 파일존재(뿌리 + "/가나다.py") {
        출력(빨강글(이름 + ": " + 뿌리 + " 에 가나다.py 가 없어요 (저장소 폴더에서 셸을 시작하세요)"))
        반환
    }
    명령 = "python3 \"" + 뿌리 + "/가나다.py\" 실행 \"" + 뿌리 + "/examples/" + 이름 + ".ㄱㄴㄷ\""
    만약 길이(파일인자) > 0 { 명령 = "메모장파일='" + 파일인자 + "' " + 명령 }
    외부실행하기(명령)                       # stdio 상속 → 대화형으로 넘어감
}

# ============================== 시작 배너 + 메인 루프
출력(색칠("══════ 가나다 OS · 한글 셸 ══════", "청록"))
출력("🇰🇷 한글로 컴퓨터를 부려요. " + 색칠("도움말", "노랑") + " 을 입력해 보세요!")

동안 참 {
    줄 = 입력(색칠("가나다", "초록") + " " + 위치표시() + " ▶ ")
    만약 타입(줄) == "없음" { 출력("")
        멈춤 }                                # EOF(Ctrl-D·파이프 끝) → 종료
    줄 = 다듬기(줄)
    만약 길이(줄) == 0 { 계속 }
    조각 = 나누기(줄)
    명령 = 조각[0]
    만약 명령 == "도움말" 또는 명령 == "도움" 또는 명령 == "?" { 도움말표() }
    아니면 만약 명령 == "목록" 또는 명령 == "ls" {
        만약 길이(조각) > 1 { 목록보기(합치기(조각[1:], " ")) }
        아니면 { 목록보기(".") }
    }
    아니면 만약 명령 == "이동" 또는 명령 == "cd" {
        곳 = 환경변수("HOME", ".")
        만약 길이(조각) > 1 { 곳 = 합치기(조각[1:], " ") }
        시도 { 위치변경(곳) } 잡기(오류) { 출력(빨강글(오류)) }
    }
    아니면 만약 명령 == "어디" 또는 명령 == "pwd" { 출력(현재위치()) }
    아니면 만약 명령 == "보기" 또는 명령 == "cat" {
        만약 길이(조각) > 1 { 보기하기(합치기(조각[1:], " ")) }
        아니면 { 출력(빨강글("사용법: 보기 <파일>")) }
    }
    아니면 만약 명령 == "만들기" 또는 명령 == "touch" {
        만약 길이(조각) > 1 { 만들기하기(합치기(조각[1:], " ")) }
        아니면 { 출력(빨강글("사용법: 만들기 <이름>  (이름이 /로 끝나면 폴더)")) }
    }
    아니면 만약 명령 == "지우기" 또는 명령 == "rm" {
        만약 길이(조각) > 1 { 지우기하기(합치기(조각[1:], " ")) }
        아니면 { 출력(빨강글("사용법: 지우기 <경로>")) }
    }
    아니면 만약 명령 == "복사" 또는 명령 == "cp" {
        만약 길이(조각) == 3 {
            시도 { 출력("복사됨 → " + 파일복사(조각[1], 조각[2])) } 잡기(오류) { 출력(빨강글(오류)) }
        }
        아니면 { 출력(빨강글("사용법: 복사 <원본> <대상>")) }
    }
    아니면 만약 명령 == "이름바꾸기" 또는 명령 == "mv" 또는 명령 == "옮기기" {
        만약 길이(조각) == 3 {
            시도 { 이름바꾸기(조각[1], 조각[2])
                출력(조각[1] + " → " + 조각[2]) } 잡기(오류) { 출력(빨강글(오류)) }
        }
        아니면 { 출력(빨강글("사용법: 이름바꾸기 <옛경로> <새경로>")) }
    }
    아니면 만약 명령 == "찾기" 또는 명령 == "find" {
        만약 길이(조각) > 1 { 출력("🔎 " + 찾아보기(".", 조각[1]) + "개 찾음") }
        아니면 { 출력(빨강글("사용법: 찾기 <이름조각>")) }
    }
    아니면 만약 명령 == "실행" 또는 명령 == "!" {
        만약 길이(조각) > 1 { 외부실행하기(합치기(조각[1:], " ")) }
        아니면 { 출력(빨강글("사용법: 실행 <명령...>")) }
    }
    아니면 만약 명령 == "시계" 또는 명령 == "시간" { 출력("🕐 " + 날짜시간()) }
    아니면 만약 명령 == "메모장" {
        만약 길이(조각) > 1 { 앱실행("메모장", 합치기(조각[1:], " ")) }
        아니면 { 앱실행("메모장", "") }
    }
    아니면 만약 명령 == "계산기" { 앱실행("계산기", "") }
    아니면 만약 명령 == "끝" 또는 명령 == "종료" 또는 명령 == "exit" { 출력("👋 안녕히!")
        멈춤 }
    아니면 { 출력("모르는 명령: " + 명령 + " — '도움말' 을 입력해 보세요") }
}
