# 계산기 — 사칙연산 대화형 계산기 (가나다 OS 미니 앱)
# 실행: python3 가나다.py 실행 examples/계산기.ㄱㄴㄷ  (가나다셸에서 '계산기' 로도 실행)

출력("🧮 가나다 계산기 — 예: 3 + 4  (연산: + - * / %) · '끝' 으로 종료")
동안 참 {
    식 = 입력("🧮 계산> ")
    만약 타입(식) == "없음" { 출력("")
        멈춤 }                                # EOF → 종료
    식 = 다듬기(식)
    만약 길이(식) == 0 { 계속 }
    만약 식 == "끝" { 멈춤 }
    조각 = 나누기(식)
    만약 길이(조각) != 3 또는 아니다 숫자인가(조각[0]) 또는 아니다 숫자인가(조각[2]) {
        출력("형식이 틀렸어요 — 예: 3 + 4")
        계속
    }
    가 = 숫자(조각[0])
    나 = 숫자(조각[2])
    연산 = 조각[1]
    만약 (연산 == "/" 또는 연산 == "%") 그리고 나 == 0 { 출력("0으로는 나눌 수 없어요")
        계속 }
    만약 연산 == "+" { 출력("= " + (가 + 나)) }
    아니면 만약 연산 == "-" { 출력("= " + (가 - 나)) }
    아니면 만약 연산 == "*" { 출력("= " + (가 * 나)) }
    아니면 만약 연산 == "/" { 출력("= " + (가 / 나)) }
    아니면 만약 연산 == "%" { 출력("= " + (가 % 나)) }
    아니면 { 출력("모르는 연산: " + 연산 + " (+ - * / % 만 돼요)") }
}
출력("계산기를 닫아요 👋")
