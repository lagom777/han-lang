# 파일목록 — 폴더 안 파일 나열·필터 (일괄 처리)
# 작업 폴더에 만들고 끝에 지운다 — /tmp 를 훑으면 남이 남긴 파일까지 세어 결과가 흔들린다
파일쓰기("han_data_1.txt", "첫째")
파일쓰기("han_data_2.txt", "둘째")

전체 = 파일목록(".")
내것 = 거르기(전체, 람다(f) { 반환 시작(f, "han_data_") })

출력("han_data_ 파일 " + 길이(내것) + "개:")
반복 f 를 정렬(내것) 에서 {
    출력(" - " + f)
}

반복 f 를 내것 에서 { 파일삭제(f) }
