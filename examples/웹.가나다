# 웹 서버 — 가나다로 만드는 웹 앱. 실행하면 http://localhost:8000 에서 서비스.
#   python3 가나다.py 실행 examples/웹.가나다
# 라우트는 {경로: 함수} 사전. 각 함수는 요청 사전 {메서드,경로,질의,본문,쿠키} 하나를 받아
# 문자열(→200 text/html) 또는 {상태,헤더,본문[,쿠키설정]} 사전을 돌려준다.

함수 홈(요청) {
    반환 "<h1>가나다 웹</h1>
<p>한글로 만든 웹 앱이에요.</p>
<ul>
  <li><a href='/안녕?이름=철수'>/안녕?이름=철수</a> — 질의 되돌려주기</li>
  <li><a href='/에이아이?물음=한국어로 인사'>/에이아이?물음=...</a> — AI 답변</li>
  <li><a href='/방문'>/방문</a> — 쿠키로 방문 횟수 세기</li>
  <li><a href='/방명록'>/방명록</a> — SQLite 방명록</li>
</ul>"
}

함수 인사(요청) {
    이름 = 값얻기(요청["질의"], "이름", "손님")
    반환 "<h1>안녕하세요, " + 이름 + "님!</h1><p><a href='/'>홈으로</a></p>"
}

함수 에이아이(요청) {
    물음 = 값얻기(요청["질의"], "물음", "가나다 언어를 한 줄로 소개해줘")
    답 = ""
    만약 환경변수("OPENROUTER_API_KEY", "") == "" {
        답 = "(OPENROUTER_API_KEY 를 설정하면 실제 AI 답변이 나와요)"
    } 아니면 {
        답 = 질문(물음)
    }
    반환 "<h1>AI</h1><p><b>물음:</b> " + 물음 + "</p><p><b>답:</b> " + 답 + "</p>"
}

함수 방문(요청) {
    횟수 = 숫자(값얻기(요청["쿠키"], "방문", "0")) + 1
    반환 {
        "본문": "<h1>" + 횟수 + "번째 방문이에요!</h1><p><a href='/방문'>새로고침</a> · <a href='/'>홈으로</a></p>",
        "쿠키설정": {"방문": "" + 횟수},
    }
}

# SQLite 방명록 — 파일 경로(예: "방명록.db")를 주면 재시작해도 글이 유지된다
자료 = 자료열기(":memory:")
실행(자료, "CREATE TABLE IF NOT EXISTS 방명록(id INTEGER PRIMARY KEY, 이름 TEXT, 말 TEXT)")

함수 방명록(요청) {
    이름 = 값얻기(요청["질의"], "이름", "")
    말 = 값얻기(요청["질의"], "말", "")
    만약 이름 != "" 그리고 말 != "" {
        실행(자료, "INSERT INTO 방명록(이름, 말) VALUES (?, ?)", [이름, 말])
    }
    글들 = 질의(자료, "SELECT 이름, 말 FROM 방명록 ORDER BY id DESC")
    줄들 = 변환(글들, 람다(글) { 반환 "<li><b>" + 글["이름"] + "</b>: " + 글["말"] + "</li>" })
    반환 "<h1>방명록</h1>
<form action='/방명록'>
  <input name='이름' placeholder='이름'> <input name='말' placeholder='한마디'>
  <button>남기기</button>
</form>
<ul>" + 합치기(줄들, "") + "</ul>
<p><a href='/'>홈으로</a></p>"
}

라우트 = {
    "/": 홈,
    "/안녕": 인사,
    "/에이아이": 에이아이,
    "/방문": 방문,
    "/방명록": 방명록,
}

서버(8000, 라우트)
