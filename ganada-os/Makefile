# 가나다 — 숫자·기호 시드. 제품 표면 영어 없음.
# 확장자: .ㄱㄴㄷ(소스) .ㄱㅂ(바이트) .기대(골든)
# 실행기: 가상

체계 := $(shell uname -s)
파이썬 ?= python3
조립 ?= as
연결 ?= ld

가상 = 가상
시드물체 = 산출/가상.o

ifeq ($(체계),Darwin)
시드조립 = 시드/가상.s
아치 ?= arm64
SDK ?= $(shell xcrun --show-sdk-path 2>/dev/null)
else
시드조립 = 시드/리눅스.s
endif

검사목록 = 인사 셈 변수 조건 비교 동안 누적 아니면 우선 나머지 더함 두배 피보 파일 많이
바이트들 = $(검사목록:%=산출/%.ㄱㅂ)

.PHONY: 모두 검사 청소 디렉

모두: 디렉 $(가상)

디렉:
	@mkdir -p 산출

$(시드물체): $(시드조립) | 디렉
ifeq ($(체계),Darwin)
	$(조립) -arch $(아치) -o $@ $(시드조립)
else
	$(조립) -o $@ $(시드조립)
endif

$(가상): $(시드물체)
ifeq ($(체계),Darwin)
	$(연결) -arch $(아치) -e _main -o $@ $(시드물체) -lSystem -syslibroot $(SDK)
else
	$(연결) -o $@ $(시드물체)
endif

산출/%.ㄱㅂ: 검사/%.ㄱㄴㄷ 사다리/묶기 | 디렉
	chmod +x 사다리/묶기
	$(파이썬) 사다리/묶기 $< $@

검사: $(가상) $(바이트들)
	@set -e; for t in $(검사목록); do \
	  echo "=== $$t ==="; \
	  ./$(가상) 산출/$$t.ㄱㅂ | tee 산출/$$t.결과; \
	  diff -u 검사/$$t.기대 산출/$$t.결과; \
	done
	@echo "검사 통과 (숫자·기호 핵 · 시드=어셈블리 · 사다리=임시)"

# 영문 별칭 없음 — test 같은 영어 타깃 의도적 미제공

청소:
	rm -rf 산출 $(가상)
