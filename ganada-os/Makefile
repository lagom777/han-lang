# 가나다 — 숫자·기호 시드. 검사는 기계어.
# .ㄱㄴㄷ → 첫묶기(ELF) → .ㄱㅂ → 낳기 → ELF → CPU
# 가상은 디버그용. 검사 경로에 없음.

체계 := $(shell uname -s)
조립 ?= as
연결 ?= ld

가상 = 가상
낳기 = 낳기
정본묶기 = 컴파일러/첫묶기.ㄱㅂ
묶는손 = 산출/첫묶기
뼈물체 = 산출/뼈.o
뼈빈 = 산출/뼈.bin
낳기물체 = 산출/낳기.o

ifeq ($(체계),Darwin)
시드조립 = 시드/가상.s
아치 ?= arm64
SDK ?= $(shell xcrun --show-sdk-path 2>/dev/null)
else
시드조립 = 시드/리눅스.s
endif

검사목록 = 인사 셈 변수 조건 비교 동안 누적 아니면 우선 나머지 더함 두배 피보 파일 많이 멈춤
바이트들 = $(검사목록:%=산출/%.ㄱㅂ)
실행들 = $(검사목록:%=산출/%.실행)

.PHONY: 모두 검사 청소 디렉 다시묶기 가상만

모두: 디렉 $(낳기) $(묶는손)

디렉:
	@mkdir -p 산출

$(뼈물체): 시드/뼈.s | 디렉
	$(조립) --64 -o $@ 시드/뼈.s

$(뼈빈): $(뼈물체)
	$(연결) -Ttext=0x400078 --oformat=binary -e _start -o $@ $(뼈물체)

$(낳기물체): 시드/낳기.s $(뼈빈)
	$(조립) --64 -o $@ 시드/낳기.s

$(낳기): $(낳기물체)
	$(연결) -o $@ $(낳기물체)

$(묶는손): $(낳기) $(정본묶기)
	./$(낳기) $(정본묶기) $@
	chmod +x $@

산출/%.ㄱㅂ: 검사/%.ㄱㄴㄷ $(묶는손) | 디렉
	./$(묶는손) $< $@

산출/%.실행: 산출/%.ㄱㅂ $(낳기)
	./$(낳기) $< $@
	chmod +x $@

검사: $(실행들)
	@set -e; for t in $(검사목록); do \
	  echo "=== $$t ==="; \
	  ./산출/$$t.실행 | tee 산출/$$t.결과; \
	  diff -u 검사/$$t.기대 산출/$$t.결과; \
	done
	@echo "검사 통과 (숫자 IR → 기계어 ELF · 묶기=가나다 · CPU가 실행)"

다시묶기: $(묶는손)
	./$(묶는손) 컴파일러/첫묶기.ㄱㄴㄷ 산출/첫묶기.새.ㄱㅂ
	cmp $(정본묶기) 산출/첫묶기.새.ㄱㅂ
	./$(낳기) 산출/첫묶기.새.ㄱㅂ $(정본묶기).새
	cp 산출/첫묶기.새.ㄱㅂ $(정본묶기)

# 디버그용 해석기. 검사에 안 씀.
가상만: 디렉
	$(조립) --64 -o 산출/가상.o $(시드조립)
	$(연결) -o $(가상) 산출/가상.o

청소:
	rm -rf 산출 $(가상) $(낳기)
