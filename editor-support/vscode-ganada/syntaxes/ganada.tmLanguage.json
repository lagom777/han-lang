{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "가나다",
  "scopeName": "source.ganada",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#builtins"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.ganada",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.ganada",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.ganada",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.ganada",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.ganada",
          "match": "(?<![\\w가-힣])(참|거짓|없음)(?![\\w가-힣])"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ganada",
          "match": "(?<![\\w가-힣])(함수|만약|아니면|동안|반복|반환|멈춤|계속|시도|잡기|람다|가져오기)(?![\\w가-힣])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.word.ganada",
          "match": "(?<![\\w가-힣])(부터|까지|에서|를|그리고|또는|아니다)(?![\\w가-힣])"
        },
        {
          "name": "keyword.operator.ganada",
          "match": "==|!=|<=|>=|\\+=|-=|\\*=|/=|[+\\-*/%<>=]"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.ganada",
          "match": "(?<![\\w가-힣])(제이슨문자열|오른쪽채우기|가운데채우기|최대공약수|최소공배수|제이슨파싱|무작위정수|무작위선택|사전만들기|왼쪽채우기|표준편차|줄나누기|체계질문|숫자인가|글자인가|거듭제곱|파일읽기|파일쓰기|이어쓰기|파일존재|파일목록|환경변수|정렬기준|상위기준|최대기준|최소기준|자료열기|자료닫기|중앙값|최빈값|정규화|나누기|합치기|거꾸로|대문자|소문자|다듬기|말줄임|바꾸기|절댓값|반올림|천단위|사이값|제곱근|항목들|값얻기|키있나|거르기|그룹화|평탄화|누적합|누적곱|무작위|교집합|합집합|차집합|저장소|고치기|입력폼|출력|길이|숫자|추가|평균|정렬|상위|최대|최소|범위|간격|위치|모델|질문|분류|요약|번역|추출|포함|시작|타입|올림|내림|입력|모듈|지금|키들|값들|변환|생성|분할|접기|서식|찾기|있나|모두|고유|개수|빈도|묶음|묶기|회전|전치|병합|발생|서버|실행|질의|넣기|빼기|문서|목록|연결|합|끝|글)(?![\\w가-힣])"
        }
      ]
    }
  }
}
