{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "가나다",
  "scopeName": "source.ganada",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#builtins"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.ganada",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.ganada",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.ganada",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.ganada",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.ganada",
          "match": "(?<![\\w가-힣])(참|거짓|없음)(?![\\w가-힣])"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ganada",
          "match": "(?<![\\w가-힣])(함수|만약|아니면|동안|반복|반환|멈춤|계속|시도|잡기|람다|가져오기)(?![\\w가-힣])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.word.ganada",
          "match": "(?<![\\w가-힣])(부터|까지|에서|를|그리고|또는|아니다)(?![\\w가-힣])"
        },
        {
          "name": "keyword.operator.ganada",
          "match": "==|!=|<=|>=|\\+=|-=|\\*=|/=|[+\\-*/%<>=]"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.ganada",
          "match": "(?<![\\w가-힣])(가운데채우기|오른쪽채우기|제이슨문자열|무작위선택|무작위정수|사전만들기|오른다듬기|왼쪽채우기|이름바꾸기|제이슨파싱|최대공약수|최소공배수|거듭제곱|공백인가|글자인가|날짜시간|상위기준|숫자인가|외부실행|왼다듬기|위치변경|이어쓰기|자료닫기|자료열기|정렬기준|줄나누기|체계질문|최대기준|최소기준|파일목록|파일복사|파일삭제|파일쓰기|파일읽기|파일정보|파일존재|폴더생성|표준편차|현재위치|환경변수|값얻기|거꾸로|거르기|고치기|교집합|그룹화|나누기|누적곱|누적합|다듬기|대문자|말줄임|무작위|바꾸기|반올림|사이값|소문자|입력폼|저장소|절댓값|정규화|제곱근|중앙값|차집합|천단위|최빈값|키있나|평탄화|합집합|합치기|항목들|간격|값들|개수|거래|고유|길이|내림|넣기|모델|모두|모듈|목록|묶기|묶음|문서|발생|번역|범위|변환|병합|분류|분할|빈도|빼기|상위|색칠|생성|서버|서식|숫자|시작|실행|연결|올림|요약|위치|입력|있나|전치|접기|정렬|지금|질문|질의|찾기|최대|최소|추가|추출|출력|키들|타입|평균|포함|회전|글|끝|합)(?![\\w가-힣])"
        }
      ]
    }
  }
}
