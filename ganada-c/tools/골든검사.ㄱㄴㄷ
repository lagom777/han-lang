# 골든 코퍼스 러너 — 파이썬 없이 C 구현을 회귀 검증한다.
# 이 러너 자체가 가나다로 쓰였고, 검사 대상인 C 바이너리가 이 파일을 실행한다.
#
# 실행: make test            (직접: ./ganada 실행 tools/골든검사.ㄱㄴㄷ  — ganada-c 폴더에서)
# 환경변수(전부 기본값 있음): GANADA_REPO 레포 뿌리 · GANADA_GOLDEN 코퍼스 · GANADA_BIN 검사할 바이너리
#                            GANADA_GOLDEN_WORK 작업폴더(한 실행이 독차지해야 한다 — 아래 참고)
# 코퍼스 형식·재생성·제외 규칙은 tests/golden/README.md 참고.

뿌리 = 환경변수("GANADA_REPO", 현재위치() + "/..")
골든 = 환경변수("GANADA_GOLDEN", 현재위치() + "/tests/golden")
바이너리 = 환경변수("GANADA_BIN", 현재위치() + "/ganada")

# 케이스 작업폴더·출력 캡처 (코퍼스를 더럽히지 않게 밖에 둔다).
# 두 실행이 같은 폴더를 쓰면 서로의 출력 캡처를 덮고 임시칸을 rm -rf 해서 있지도 않은
# 불일치가 잔뜩 나온다 — 그래서 make test 가 실행마다 다른 폴더를 넘긴다.
작업 = 환경변수("GANADA_GOLDEN_WORK", "/tmp/ganada-golden-work")
임시칸 = 작업 + "/칸"
출력받기 = 작업 + "/출력.txt"
오류받기 = 작업 + "/오류.txt"

# 전부 통과했을 때만 남기는 표식. make test 가 이 파일 존재로 성공을 판정한다 —
# 인터프리터의 오류 종료코드가 깨져 발생()이 0으로 끝나도 검사가 통과로 보이지 않게.
통과표 = 환경변수("GANADA_GOLDEN_OK", 작업 + "/통과표")

# 케이스마다 환경을 고정한다 — 골든생성.py 의 FIXED_ENV/UNSET_ENV 와 같은 값이어야 한다
지울것 = "OPENROUTER_API_KEY OPENAI_API_KEY ANTHROPIC_API_KEY"
고정환경 = "HOME='/ganada-golden-home' TZ=UTC HAN_TEST_VAR='값123'"


# 한 줄(케이스) → 껍데기 명령. 표준출력·표준오류를 파일로 갈라 받는다.
함수 명령만들기(케이스) {
    임시인가 = 케이스[7] == "임시"
    작업폴더 = 고르기(임시인가, 임시칸, 뿌리 + "/" + 케이스[7])
    입력 = 고르기(케이스[6] == "-", "/dev/null", 뿌리 + "/" + 케이스[6])
    앞 = 고르기(임시인가, "rm -rf '" + 임시칸 + "' && mkdir -p '" + 임시칸 + "' && ", "")
    반환 앞 + "cd '" + 작업폴더 + "' && unset " + 지울것 + "; " + 고정환경
        + " '" + 바이너리 + "' 실행 '" + 뿌리 + "/" + 케이스[4] + "'"
        + " > '" + 출력받기 + "' 2> '" + 오류받기 + "' < '" + 입력 + "'"
}


함수 통과인가(케이스) {
    코드 = 외부실행(명령만들기(케이스))
    만약 코드 != 숫자(케이스[3]) { 반환 거짓 }
    기대 = 파일읽기(뿌리 + "/" + 케이스[5])
    만약 케이스[2] == "오류포함" {
        반환 포함(파일읽기(오류받기), 기대) 또는 포함(파일읽기(출력받기), 기대)
    }
    반환 파일읽기(출력받기) == 기대
}


함수 한줄로(글) { 반환 말줄임(바꾸기(글, "\n", "⏎"), 90) }


# 통과인가() 직후에만 부른다 — 캡처 파일에 그 케이스의 실제 출력이 남아 있다
함수 실패알림(케이스) {
    출력("  불일치 [" + 케이스[0] + "] " + 케이스[1] + "  (" + 케이스[8] + ")")
    출력("    소스: " + 케이스[4])
    출력("    검사: " + 케이스[2] + " · 기대코드 " + 케이스[3])
    출력("    기대: " + 한줄로(파일읽기(뿌리 + "/" + 케이스[5])))
    출력("    실제: " + 한줄로(파일읽기(출력받기)))
    만약 길이(파일읽기(오류받기)) > 0 { 출력("    오류: " + 한줄로(파일읽기(오류받기))) }
}


# ---------------------------------------------------------------- 코퍼스 읽기
행들 = []
기대케이스수 = -1
기대예제수 = -1
반복 하나 를 줄나누기(파일읽기(골든 + "/목록.tsv")) 에서 {
    만약 길이(다듬기(하나)) == 0 또는 시작(하나, "#") { 계속 }
    조각 = 나누기(하나, "\t")
    만약 길이(조각) != 9 { 발생("목록.tsv 형식 오류(칸 9개가 아님): " + 하나) }
    만약 조각[0] == "합계" {
        기대케이스수 = 숫자(나누기(조각[1], "=")[1])
        기대예제수 = 숫자(나누기(조각[2], "=")[1])
        계속
    }
    추가(행들, 조각)
}
만약 길이(행들) == 0 { 발생("코퍼스가 비었다 — tools/골든생성.py 로 만들어야 한다") }
외부실행("mkdir -p '" + 임시칸 + "' && rm -f '" + 통과표 + "'")


# ------------------------------------------------- 1단계: 러너 자가검증(캐너리)
# 러너가 가나다로 쓰인 만큼 인터프리터가 깨지면 러너도 함께 거짓말할 수 있다.
# 그래서 "반드시 실패해야 하는 케이스"를 먼저 돌려 비교 경로가 살아 있음을 증명한다.
자가 = 0
반복 케이스 를 행들 에서 {
    만약 케이스[0] == "자가통과" {
        만약 아니다 통과인가(케이스) {
            실패알림(케이스)
            발생("자가검증: 통과해야 할 케이스가 실패 — 러너의 비교 경로가 망가졌다")
        }
        자가 += 1
    }
    만약 케이스[0] == "자가실패" {
        만약 통과인가(케이스) {
            발생("자가검증: 일부러 틀린 케이스가 통과 — 이 러너는 아무것도 검증하지 못한다")
        }
        자가 += 1
    }
}
만약 자가 != 2 { 발생("자가검증 케이스 2건이 목록에 없다 (있어야 러너를 믿을 수 있다)") }


# ---------------------------------------------------------- 2단계: 코퍼스 대조
시작시각 = 지금()
케이스통과 = 0
케이스실패 = 0
예제통과 = 0
예제실패 = 0
알린수 = 0
반복 케이스 를 행들 에서 {
    만약 시작(케이스[0], "자가") { 계속 }
    좋음 = 통과인가(케이스)
    만약 아니다 좋음 그리고 알린수 < 15 {          # 보고는 15건까지만(conform.py 와 같은 상한)
        실패알림(케이스)
        알린수 += 1
    }
    만약 케이스[0] == "케이스" {
        만약 좋음 { 케이스통과 += 1 } 아니면 { 케이스실패 += 1 }
    } 아니면 {
        만약 좋음 { 예제통과 += 1 } 아니면 { 예제실패 += 1 }
    }
}

실패 = 케이스실패 + 예제실패
만약 실패 > 알린수 { 출력("  ... 나머지 불일치 " + (실패 - 알린수) + "건 생략") }
출력("[golden:tests] " + 케이스통과 + "/" + (케이스통과 + 케이스실패) + " 통과")
출력("[golden:examples] " + 예제통과 + "/" + (예제통과 + 예제실패) + " 일치")
출력("[golden] 자가검증 " + 자가 + "/2 · " + 반올림(지금() - 시작시각, 2) + "초 · 바이너리 " + 바이너리)
만약 실패 > 0 { 발생("골든 코퍼스 불일치 " + 실패 + "건 — 위 목록 참고") }

# 통과 수가 아니라 "돌린 케이스 수" 를 합계와 대조한다 — 목록이 잘려 조용히 줄어드는 걸 막는다
만약 기대케이스수 < 0 { 발생("목록.tsv 에 합계 줄이 없다 — 코퍼스가 온전하지 않다") }
만약 (케이스통과 + 케이스실패) != 기대케이스수 또는 (예제통과 + 예제실패) != 기대예제수 {
    발생("코퍼스 건수가 합계와 다르다 — 목록이 잘렸나? 합계 케이스 " + 기대케이스수
        + " 예제 " + 기대예제수)
}
파일쓰기(통과표, "케이스 " + 케이스통과 + " · 예제 " + 예제통과 + "\n")
출력("[golden] 전부 통과")
