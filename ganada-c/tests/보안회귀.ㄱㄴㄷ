# ---------------------------------------------------------------- 11. 자료(SQL) 셈의 SIGFPE
# 질의·실행의 / % 가 최소정수 / -1, 최소정수 % -1, a % 0.5(정수로 바꾸면 0)에서 SIGFPE 로
# 프로세스째 죽었다 — 서버 라우트가 ? 로 받은 사용자 값으로도 닿는다. sqlite 처럼 실수·NULL 이어야 한다.
자료 = 자료열기(":memory:")
실행(자료, "CREATE TABLE t (a INTEGER, b)")
실행(자료, "INSERT INTO t VALUES (5, 0)")
반복 쌍 를 [["a % ?", 0.5, 없음], ["? / -1", -최대 - 1, 9223372036854775808.0], ["? % -1", -최대 - 1, 0],
          ["a + ?", 최대, 9223372036854775808.0], ["a / ?", 0, 없음]] 에서 {
    실행(자료, "UPDATE t SET b = " + 쌍[0], [쌍[1]])
    같아야("자료 셈 " + 쌍[0], 질의(자료, "SELECT b FROM t")[0]["b"], 쌍[2])
}
자료닫기(자료)


