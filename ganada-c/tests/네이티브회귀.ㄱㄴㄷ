# 네이티브 회귀 그물 — `실행` 의 네이티브 길(LLVM)이 인터프리터와 똑같이 도는지 본다.
# 파이썬 없이 돈다(가나다로 쓰였고 검사 대상 C 바이너리가 실행한다).
#
# 실행: make test        (직접: ./ganada 실행 tests/네이티브회귀.ㄱㄴㄷ  — ganada-c 폴더에서)
# 환경변수: GANADA_BIN 검사할 바이너리 · GANADA_NATIVE_WORK 작업폴더 · GANADA_NATIVE_OK 통과표
#
# `실행` 은 네이티브를 먼저 시도하고 못 하면 인터프리터로 간다. 그래서 네이티브가 받아들인
# 프로그램은 표준출력·오류 문구·종료코드가 인터프리터와 같아야 한다. 아래 사례는 한때 네이티브가
# 조용히 다른 답을 내던 것들이다(스텝 0 무한 반복, 음수 스텝, 실수 나누기, 참/거짓이 1/0,
# 미정의 변수가 0, 인자 수 무시 …). 각 사례를 두 길로 돌려 비교한다.

작업 = 환경변수("GANADA_NATIVE_WORK", "/tmp/ganada-네이티브회귀")
통과표 = 환경변수("GANADA_NATIVE_OK", 작업 + "/통과표")
바이너리 = 환경변수("GANADA_BIN", 현재위치() + "/ganada")
외부실행("rm -rf '" + 작업 + "' && mkdir -p '" + 작업 + "'")
폴백 = "LLVM 미지원 → 인터프리터\n"

# [이름, 소스, 네이티브로 돌아야 하나]
사례들 = [
    ["스텝0", "반복 i 를 0 부터 5 까지 0 씩 { 출력(i) }", 참],
    ["음수스텝", "반복 i 를 3 부터 1 까지 -1 씩 { 출력(i) }\n반복 i 를 5 부터 1 까지 { 출력(i) }", 참],
    ["반복변수", "i = 100\n반복 i 를 1 부터 3 까지 {\n 출력(i)\n i = i + 10\n}\n출력(i)", 참],
    ["참거짓", "출력(참 그리고 거짓)\n출력(1 < 2)\n출력(\"x\" + 참)\n출력(참 + 1)\n출력(아니다 5)", 참],
    ["단락값", "함수 찍(n) {\n 출력(\"찍 \" + n)\n 반환 n\n}\n출력(0 또는 5)\n출력(3 그리고 5)\nx = 0 그리고 찍(1)\n출력(x)\n만약 찍(2) 또는 찍(3) { 출력(\"예\") }", 참],
    ["나머지", "출력(-7 % 3)\n출력(7 % -3)\nx = -9223372036854775807 - 1\n출력(x % -1)\n출력(5 % (x - x))", 참],
    ["큰수비교", "출력(9007199254740993 < 9007199254740992)\n출력(9007199254740993 == 9007199254740992)", 참],
    ["깊은재귀", "함수 세기(n) { 반환 1 + 세기(n + 1) }\n출력(세기(0))", 참],
    ["문자열", "s = \"\"\n반복 i 를 1 부터 3 까지 { s = s + i + \",\" }\n출력(s, s == \"1,2,3,\", \"a\" < \"b\")", 참],
    ["재귀함수", "함수 피보(n) {\n 만약 n < 2 { 반환 n }\n 반환 피보(n - 1) + 피보(n - 2)\n}\n출력(피보(20))", 참],
    ["실수나누기", "출력(10 / 4)\n출력(10 / 2)", 거짓],
    ["미정의", "출력(1)\n출력(없는변수)", 거짓],
    ["전역대입", "x = 1\n함수 f() {\n x = 5\n 반환 0\n}\nf()\n출력(x)", 거짓],
    ["인자수", "함수 더(가, 나) { 반환 가 + 나 }\n출력(더(1))", 거짓],
    ["없음값", "함수 f() { 출력(\"x\") }\n출력(f())", 거짓],
    ["정의전호출", "출력(f(1))\n함수 f(x) { 반환 x }", 거짓],
    ["반복뒤변수", "반복 i 를 1 부터 3 까지 { t = i }\n출력(t)", 거짓]
]

# clang 이 없으면 네이티브는 늘 폴백한다 — 그땐 비교만 하고 "네이티브로 돌았나" 는 안 본다
클랭있음 = 외부실행("command -v clang > /dev/null 2>&1") == 0

함수 돌리기(소스, 이름, 인터프리터만) {
    앞 = 고르기(인터프리터만, "GANADA_FORCE_INTERP=1 ", "unset GANADA_FORCE_INTERP GANADA_FORCE_LLVM; ")
    코드 = 외부실행(앞 + "'" + 바이너리 + "' 실행 '" + 소스 + "' > '" + 작업 + "/" + 이름 + ".출력' 2> '"
        + 작업 + "/" + 이름 + ".오류' < /dev/null")
    반환 [코드, 파일읽기(작업 + "/" + 이름 + ".출력"), 파일읽기(작업 + "/" + 이름 + ".오류")]
}

실패 = 0
반복 사례 를 사례들 에서 {
    이름 = 사례[0]
    소스 = 작업 + "/" + 이름 + ".ㄱㄴㄷ"
    파일쓰기(소스, 사례[1] + "\n")
    가 = 돌리기(소스, 이름 + "_네이티브", 거짓)
    나 = 돌리기(소스, 이름 + "_인터프리터", 참)
    네이티브였나 = 아니다 포함(가[2], 폴백)
    같음 = 가[0] == 나[0] 그리고 가[1] == 나[1] 그리고 바꾸기(가[2], 폴백, "") == 나[2]
    만약 아니다 같음 {
        출력("  불일치 " + 이름 + " — 네이티브 코드 " + 가[0] + " / 인터프리터 코드 " + 나[0])
        출력("    네이티브:   " + 말줄임(바꾸기(가[1] + 가[2], "\n", "⏎"), 120))
        출력("    인터프리터: " + 말줄임(바꾸기(나[1] + 나[2], "\n", "⏎"), 120))
        실패 += 1
    } 아니면 만약 클랭있음 그리고 사례[2] 그리고 아니다 네이티브였나 {
        출력("  " + 이름 + ": 네이티브로 돌아야 하는데 인터프리터로 갔다")
        실패 += 1
    }
}
만약 아니다 클랭있음 { 출력("[네이티브회귀] clang 없음 — 두 길이 같은지만 봤다(모두 인터프리터)") }
만약 실패 > 0 { 발생("네이티브회귀 " + 실패 + "건 실패 — 위 목록 참고") }

파일쓰기(통과표, "네이티브회귀 전부 통과\n")
출력("[네이티브회귀] " + 길이(사례들) + "건 전부 통과")
